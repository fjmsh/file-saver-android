<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:ignore="MergeRootFrame"
	tools:context="fjm.sh.dropfiler.activity.FolderListActivity">

	<com.hchen.himiuix.MiuixAppBar
		android:id="@+id/appbar"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:title="@string/app_name">

		<androidx.fragment.app.FragmentContainerView
			android:id="@+id/fragment_container"
			android:name="fjm.sh.dropfiler.ui.MiuixListFragment"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />
	</com.hchen.himiuix.MiuixAppBar>

	<!-- Add destination: extended floating action button -->
	<LinearLayout
		android:id="@+id/fab"
		android:layout_width="wrap_content"
		android:layout_height="@dimen/fs_fab_height"
		android:layout_gravity="bottom|end"
		android:layout_margin="@dimen/fab_margin"
		android:background="@drawable/fs_button_primary"
		android:clickable="true"
		android:contentDescription="@string/folder_list_add_destination"
		android:elevation="@dimen/fs_fab_elevation"
		android:focusable="true"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="20dp"
		android:paddingEnd="24dp">

		<ImageView
			android:layout_width="@dimen/fs_icon_size"
			android:layout_height="@dimen/fs_icon_size"
			android:importantForAccessibility="no"
			app:srcCompat="@drawable/fs_ic_add"
			app:tint="?attr/fsColorOnAccent" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:fontFamily="sans-serif-medium"
			android:importantForAccessibility="no"
			android:text="@string/folder_list_add_destination"
			android:textColor="?attr/fsColorOnAccent"
			android:textSize="16sp" />
	</LinearLayout>
</FrameLayout>
