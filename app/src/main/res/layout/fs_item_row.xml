<?xml version="1.0" encoding="utf-8"?>
<!-- A Miuix styled list row inside a rounded group card. Corner radii are set per
	 position by CardListAdapter (first / middle / last of a group). -->
<com.hchen.himiuix.widget.MiuixCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/card"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginStart="@dimen/miuix_prefs_margin"
	android:layout_marginEnd="@dimen/miuix_prefs_margin">

	<LinearLayout
		android:id="@+id/row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/miuix_basic_background_color"
		android:foreground="@drawable/fs_focus_foreground"
		android:gravity="center_vertical"
		android:minHeight="@dimen/fs_row_min_height"
		android:orientation="horizontal"
		android:paddingStart="@dimen/fs_row_padding_horizontal"
		android:paddingTop="@dimen/fs_row_padding_vertical"
		android:paddingEnd="@dimen/fs_row_padding_horizontal"
		android:paddingBottom="@dimen/fs_row_padding_vertical"
		tools:ignore="UnusedAttribute">

		<FrameLayout
			android:id="@+id/icon_tile"
			android:layout_width="@dimen/fs_icon_tile"
			android:layout_height="@dimen/fs_icon_tile"
			android:background="@drawable/fs_icon_tile"
			android:importantForAccessibility="no">

			<ImageView
				android:id="@+id/icon"
				android:layout_width="@dimen/fs_icon_size"
				android:layout_height="@dimen/fs_icon_size"
				android:layout_gravity="center"
				android:importantForAccessibility="no"
				app:tint="?attr/fsColorOnAccentContainer"
				tools:srcCompat="@drawable/fs_ic_folder" />
		</FrameLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="@dimen/miuix_icon_margin"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/title"
				style="@style/MiuixTitleStyle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:focusable="false"
				android:textAlignment="viewStart"
				tools:text="Pictures" />

			<TextView
				android:id="@+id/summary"
				style="@style/MiuixSummaryStyle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:ellipsize="middle"
				android:maxLines="2"
				android:textAlignment="viewStart"
				tools:text="/Pictures/Memes" />
		</LinearLayout>

		<ImageView
			android:id="@+id/chevron"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="@dimen/miuix_indicator_margin"
			android:importantForAccessibility="no"
			android:visibility="gone"
			app:srcCompat="@drawable/miuix_indicator_arrow_right" />

		<ImageButton
			android:id="@+id/action"
			android:layout_width="@dimen/fs_touch_target"
			android:layout_height="@dimen/fs_touch_target"
			android:layout_marginEnd="0dp"
			android:background="@drawable/fs_icon_button_background"
			android:scaleType="center"
			android:visibility="gone"
			app:srcCompat="@drawable/fs_ic_delete"
			tools:ignore="ContentDescription"
			tools:visibility="visible" />

		<!-- Reordering handle; screen readers use the "Move up / down" actions instead -->
		<ImageView
			android:id="@+id/drag_handle"
			android:layout_width="@dimen/fs_touch_target"
			android:layout_height="@dimen/fs_touch_target"
			android:layout_marginEnd="-12dp"
			android:importantForAccessibility="no"
			android:scaleType="center"
			android:visibility="gone"
			app:srcCompat="@drawable/fs_ic_drag_handle"
			tools:visibility="visible" />
	</LinearLayout>

	<!-- Hairline between consecutive rows of a group (lists with dividers only).
		 Starts at the title text, like Miuix/HyperOS lists. -->
	<View
		android:id="@+id/row_divider"
		android:layout_width="match_parent"
		android:layout_height="@dimen/fs_row_divider_height"
		android:layout_gravity="top"
		android:layout_marginStart="@dimen/fs_row_divider_inset_start"
		android:layout_marginEnd="@dimen/fs_row_padding_horizontal"
		android:background="@color/fs_row_divider"
		android:importantForAccessibility="no"
		android:visibility="gone" />
</com.hchen.himiuix.widget.MiuixCardView>
