			android:strokeLineCap="round"
			android:strokeLineJoin="round" />

		<!-- continuous inward entry shape -->
		<path
			android:pathData="M218 632 C218 648 229 658 244 658 H445"
			android:strokeWidth="43"
			android:strokeColor="#FFFFFFFF"
			android:strokeLineCap="round"
			android:strokeLineJoin="round" />

		<!-- right arrow, deliberately integrated with front entry -->
		<path
			android:pathData="M395 574 L474 653 Q479 658 474 663 L395 740"
			android:strokeWidth="43"
			android:strokeColor="#FFFFFFFF"
			android:strokeLineCap="round"
			android:strokeLineJoin="round" />
