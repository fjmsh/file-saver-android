	<string name="pref_title_location_select">啟用位置選擇</string>
	<string name="pref_description_location_select">儲存時使用
		Android 的內建文件使用者介面啟用位置的選擇。這是儲存到外部
		SD 卡建議的方式。
	</string>

	<string name="pref_title_register_file">註冊多媒體掃描器</string>
	<string name="pref_description_register_file">當檔案已下載時通知多媒體掃描器。
		這有助於確保圖庫和音樂應用程式可以獲取檔案。
	</string>

	<string name="pref_title_lenient_regex">使用寬鬆的檔案名稱驗證</string>
	<string name="pref_description_lenient_regex">當這個選項停用時，檔案名稱僅限於
		英數字元、底線和連字號。當啟用時，檔案名稱不受限制。
		這增加了對非拉丁字元和語言、表情符號等等的支援。警告：這可能造成
		一些檔案無法儲存，或可能使不支援這些字元的應用程式無法運作。
	</string>

	<string name="pref_title_follow_redirects">跟隨重新導向</string>
	<string name="pref_description_follow_redirects">當一個連結重新導向到另一個頁面時，&appname;
		會跟隨重新導向到新的頁面。
	</string>

	<string name="pref_title_force_saving">強制儲存</string>
	<string name="pref_description_force_saving">強制儲存分享的項目，即使沒有
		明確的支援。警告：啟用此功能可能會對儲存有不良影響。
	</string>

	<string name="pref_title_special_imgur">儲存 Imgur 圖片</string>
	<string name="pref_description_special_imgur">當分享 Imgur 連結時，儲存第一張圖片。
	</string>

