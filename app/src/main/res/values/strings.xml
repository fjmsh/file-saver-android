		<item>Show debug information at warn level and above</item>
		<item>Show debug information at info level and above</item>
		<item>Show debug information at debug level and above</item>
		<item>Show debug information at verbose level and above</item>
	</array>
	<string name="pref_default_value_log_to_user">None</string>
