<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Theme color roles. Provided by Theme.FileSaver and replaced by
		 ThemeOverlay.FileSaver.DynamicColors when Monet colors are enabled. -->
	<attr name="fsColorAccent" format="color" />
	<attr name="fsColorOnAccent" format="color" />
	<attr name="fsColorAccentContainer" format="color" />
	<attr name="fsColorOnAccentContainer" format="color" />
	<attr name="fsColorLink" format="color" />
	<!-- Secondary action buttons (e.g. "New folder"). Accent 3 with dynamic colors. -->
	<attr name="fsColorSecondaryActionContainer" format="color" />
	<attr name="fsColorOnSecondaryActionContainer" format="color" />
	<!-- DropFiler symbol beside the main screen title. The primary accent, except where that
		 is too dark to read on the dark background (dynamic colors, dark theme). -->
	<attr name="fsColorTitleIcon" format="color" />
</resources>
