<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
		  xmlns:tools="http://schemas.android.com/tools"
		  tools:ignore="GoogleAppIndexingWarning">

	<!-- Legacy file system access. The app targets API 28 so these keep their
		 pre-scoped-storage meaning (see README, "Storage compatibility"). -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Save result notifications. The app targets API 28, so on Android 13+ the system
		 asks for this automatically when the notification channel is created. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application
		android:name=".DropFilerApplication"
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.FileSaver"
		android:fullBackupContent="@xml/backup_descriptor">
		<activity
			android:name=".activity.FolderListActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />

				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- Sharing shortcuts (Direct Share on Android 10+) -->
			<meta-data
				android:name="android.app.shortcuts"
				android:resource="@xml/shortcuts" />
		</activity>
		<activity
			android:name=".activity.FolderSelectActivity"
			android:exported="false"
			android:label="@string/title_activity_folder_select"
			android:parentActivityName=".activity.FolderListActivity" />
		<activity
			android:name=".activity.CreditsActivity"
			android:exported="false"
			android:label="@string/title_activity_credits"
			android:parentActivityName=".activity.FolderListActivity" />
		<!-- Share target: must stay exported so other apps can share to it -->
		<activity
			android:name=".activity.SaverActivity"
			android:exported="true"
			android:theme="@style/Theme.FileSaver.Sheet">
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.SEND_MULTIPLE" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<!-- "Open with DropFiler": saves a copy of the opened file (intent data) to a
				 destination. It does not view or edit files. content:// is the normal case;
				 file:// is a best-effort fallback for older apps and uses the existing legacy
				 storage permission only. No BROWSABLE / http(s): web links are not handled. -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<!-- Direct Share on Android 6.0 - 9 -->
			<meta-data
				android:name="android.service.chooser.chooser_target_service"
				android:value=".service.LocationChooserTargetService" />
		</activity>
		<activity
			android:name=".activity.SettingsActivity"
			android:exported="false"
			android:label="@string/title_activity_settings"
			android:parentActivityName=".activity.FolderListActivity" />

		<!-- DOWNLOAD_COMPLETE is sent by the DownloadManager provider (a different
			 package), so this receiver has to be exported to receive it. -->
		<receiver
			android:name=".receiver.DownloadBroadcastReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
			</intent-filter>
		</receiver>

		<!-- Bound by the system chooser only; protected by BIND_CHOOSER_TARGET_SERVICE -->
		<service android:name=".service.LocationChooserTargetService"
			android:exported="true"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_CHOOSER_TARGET_SERVICE"
			tools:ignore="ExportedService"
			tools:targetApi="m">
			<intent-filter>
				<action android:name="android.service.chooser.ChooserTargetService" />
			</intent-filter>
		</service>
	</application>

</manifest>
