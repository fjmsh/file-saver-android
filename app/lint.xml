<?xml version="1.0" encoding="utf-8"?>
<lint>
	<!-- These resources override Miuix XML library resources (colours, Chinese-only
		 default strings) or are read by name by ckChangeLog, so lint cannot see their use. -->
	<issue id="UnusedResources">
		<ignore regexp="miuix_|dialog_positive|dialog_color_|color_hue|color_saturation|color_lightness|color_alpha|changelog_master" />
	</issue>
	<!-- Deliberate override of AppCompat's popup menu item layout (smaller minimum width). -->
	<issue id="PrivateResource">
		<ignore path="src/main/res/layout/abc_popup_menu_item_layout.xml" />
	</issue>
	<!-- No core-ktx dependency on purpose; plain AndroidX APIs are used. -->
	<issue id="UseKtx" severity="ignore" />
	<issue id="KtxExtensionAvailable" severity="ignore" />
</lint>
